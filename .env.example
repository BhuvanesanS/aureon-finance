# Local Node API
PORT=8787
DATA_DIR=server/data
CORS_ORIGIN=http://localhost:5173

# Required before enabling the admin editor. Use a unique, long password and a
# cryptographically random session secret of at least 32 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Zoom Server-to-Server OAuth app. Grant meeting:write:meeting and related
# account scopes required by Zoom, then keep all three values server-side.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email confirmations via Resend. MAIL_FROM must use a verified sender/domain.
RESEND_API_KEY=
MAIL_FROM=Mubsa Fin Institute <webinars@example.com>

# WhatsApp Cloud API. Configure an approved template with body variables in
# this order: attendee name, webinar title, date/time, Zoom join URL.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en
# Set to a Graph API version enabled for your Meta app.
WHATSAPP_GRAPH_API_VERSION=
