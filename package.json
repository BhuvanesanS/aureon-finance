{
  "name": "trading-finance-advisory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env server/local.js",
    "start": "node --env-file-if-exists=.env server/local.js",
    "dev": "node server/dev.js",
    "dev:frontend": "vite",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create mubsa-fin-institute",
    "db:migrate:local": "wrangler d1 migrations apply mubsa-fin-institute --local",
    "db:migrate:remote": "wrangler d1 migrations apply mubsa-fin-institute --remote",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "wrangler": "^4.158.0"
  }
}
